#!/bin/sh
# shellcheck disable=SC2154,SC1091  # ROOT is set by the initramfs init; /scripts/functions only exists there
# Osmium Sound — first boot of the ready-made disk image.
#
# The image is written straight onto an SD card or a disk with Etcher, Rufus
# or dd, so it cannot know how big the medium is: it carries the same A/B
# layout the installer writes, but with a tiny, unformatted last partition (p4)
# in place of a real hifi-data. Here, with the root not mounted yet, that
# partition is stretched to the end of the medium, formatted as the installer
# would and seeded with the first-run marker — from which point
# scripts/local-bottom/hifi-state mounts it like on any installed unit.
#
# This image uses an MBR table (the Pi GPU bootrom reads only MBR), where
# partitions carry no labels, so the trigger is the filesystem, not a name: p4
# is the data partition by position (mirrors hifi-ab-lib.sh: data = 4), and a
# p4 that does not yet hold an ext4 is the untouched seed this image ships. A
# p4 that already holds ext4 is an ordinary hifi-data and is left alone, so
# every run is idempotent: a power cut halfway simply leaves p4 unformatted and
# the next boot does it all again.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in
    prereqs) prereqs; exit 0 ;;
esac
. /scripts/functions

slot=; rootspec=
read -r cmdline < /proc/cmdline || cmdline=
for x in $cmdline; do
    case "$x" in
        rauc.slot=*) slot=${x#rauc.slot=} ;;
        root=*) rootspec=${x#root=} ;;
    esac
done
[ -n "$slot" ] || exit 0

# By absolute path, under their own names (hooks/hifi-state): BusyBox's
# applets sit at the plain names and its mke2fs does not know -t.
SFDISK=/usr/sbin/hifi-sfdisk; PARTX=/usr/sbin/hifi-partx; BLOCKDEV=/usr/sbin/hifi-blockdev
MKE2FS=/usr/sbin/hifi-mke2fs
for t in SFDISK PARTX BLOCKDEV MKE2FS; do
    eval "v=\$$t"
    [ -x "$v" ] || exit 0    # an initrd without the tools: leave the partition alone
done

case "$rootspec" in
    PARTUUID=*) rootdev=$(readlink -f "/dev/disk/by-partuuid/${rootspec#PARTUUID=}" 2>/dev/null) ;;
    UUID=*)     rootdev=$(readlink -f "/dev/disk/by-uuid/${rootspec#UUID=}" 2>/dev/null) ;;
    /dev/*)     rootdev=$(readlink -f "$rootspec" 2>/dev/null) ;;
    *)          rootdev=$(readlink -f "${ROOT:-}" 2>/dev/null) ;;
esac
[ -n "$rootdev" ] && [ -b "$rootdev" ] || exit 0
disk=$(basename "$(readlink -f "/sys/class/block/${rootdev#/dev/}/..")")
diskdev="/dev/$disk"
[ -b "$diskdev" ] || exit 0

# The data partition is p4 of the root disk (fixed MBR numbering, the same as
# hifi-ab-lib.sh ab_part_by_name). Find its /dev node through sysfs.
pn=4
part=
for d in /sys/class/block/"$disk"*; do
    [ -f "$d/partition" ] || continue
    if [ "$(cat "$d/partition" 2>/dev/null)" = "$pn" ]; then
        part="/dev/$(basename "$d")"
        break
    fi
done
[ -n "$part" ] || exit 0

# Already carries a filesystem (every boot after the first): it is an ordinary
# hifi-data, leave it. On MBR there is no label to key on, so the presence of a
# filesystem is the stand-in for the old "renamed to hifi-data" signal — and,
# unlike a trial mount, blkid never risks reformatting a real filesystem whose
# journal merely needs replay. Only an unformatted seed (empty TYPE) falls
# through to grow + format + seed below.
if [ -n "$(blkid -o value -s TYPE "$part" 2>/dev/null)" ]; then
    exit 0
fi

LOG=/run/hifi-data-grow.log
say() {
    echo "hifi-data-grow: $*" >> "$LOG"
    log_begin_msg "hifi-data-grow: $*"
    log_end_msg
}
plymouth display-message --text="Osmium Sound: preparing the disk for first use…" 2>/dev/null || true
say "growing $part (partition $pn of $diskdev) to the end of the disk"

# The last partition takes all that follows it to the end of the medium. MBR
# has no backup table to relocate to the end (unlike GPT), so this is a single
# resize. --no-reread: the kernel holds no partition of this disk open yet, but
# the check would still refuse while udev looks at it; partx tells it below.
echo ', +' | "$SFDISK" --no-reread --no-tell-kernel -N "$pn" "$diskdev" >> "$LOG" 2>&1 \
    || say "W: sfdisk could not grow partition $pn"
"$PARTX" -u --nr "$pn" "$diskdev" >> "$LOG" 2>&1 \
    || "$BLOCKDEV" --rereadpt "$diskdev" >> "$LOG" 2>&1 || true
udevadm settle --timeout=10 >/dev/null 2>&1 || true
say "partition $pn: $(( $(cat "/sys/class/block/${part#/dev/}/size" 2>/dev/null || echo 0) / 2048 )) MiB"

# Formatted exactly as hifi-disk-install.sh formats it. -t ext4 spelled out
# and /etc/mke2fs.conf in the initrd: without them mke2fs falls back to ext2.
if ! "$MKE2FS" -t ext4 -F -q -m 1 -L hifi-data -O metadata_csum_seed "$part" >> "$LOG" 2>&1; then
    # Left unformatted: hifi-state finds no ext4 on p4, runs this boot on a
    # tmpfs, and the next boot tries again.
    say "E: mke2fs failed on $part"
    exit 0
fi

# The installer's seeding, minus what hifi-state already does by itself (the
# folders and the machine-id): the first-run marker, without which the unit
# boots straight past the setup wizard.
mkdir -p /run/hifi-data-grow
if mount -t ext4 "$part" /run/hifi-data-grow >> "$LOG" 2>&1; then
    mkdir -p /run/hifi-data-grow/etc/upper/hifi-player /run/hifi-data-grow/log
    printf 'pending\n' > /run/hifi-data-grow/etc/upper/hifi-player/provisioning-pending
    cp "$LOG" /run/hifi-data-grow/log/data-grow.log 2>/dev/null || true
    sync
    umount /run/hifi-data-grow
else
    say "E: cannot mount the new filesystem on $part"
    exit 0
fi

# From here on p4 holds an ext4 labelled hifi-data (the mke2fs above): that is
# the signal hifi-state keys on, so there is no partition rename to do on MBR.
say "done: $part is hifi-data"
exit 0
