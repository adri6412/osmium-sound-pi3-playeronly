[Unit]
Description=Osmium Sound — Qt on-screen interface (DRM/KMS, eglfs)
# The two on-screen interfaces exclude each other: the Electron one runs
# inside lightdm's session, this one takes the DRM master directly. Which of
# them starts is decided by /etc/hifi-player/ui-engine through
# hifi-display-mode.sh (which enables one and disables the other); Conflicts
# here is the safety net for if both ever ended up active.
Conflicts=lightdm.service
After=hifi-api.service hifi-vumeter.service
# The boot splash is handed over the way the display managers do it: this
# unit keeps plymouth-quit.service out (Conflicts) and quits Plymouth itself,
# just before starting, with --retain-splash, so the last frame of the splash
# stays on the panel until the interface draws its first one. Before, the
# interface waited for plymouth-quit-wait.service: in between, the text
# console showed systemd's "[ OK ] Finished Terminate Plymouth Boot Screen"
# lines for a second or two (they are also switched off on the kernel command
# line, systemd.show_status=0, so a late unit never prints there either).
# Plymouth must have let go of the DRM master before the start, or the
# first attempt dies with "setCrtc: Permission denied": `plymouth quit`
# returns once the daemon has gone, and Restart= below is the parachute.
Conflicts=plymouth-quit.service
After=systemd-user-sessions.service plymouth-start.service
# No ceiling on the attempts: if the first one finds the DRM still busy (a hot
# swap from the other interface), with the stock limit systemd gives up after
# five tries and the screen stays black for good.
StartLimitIntervalSec=0

[Service]
Type=simple
# An active TTY is required: without one the process never gets the DRM master
# and cannot set the video mode. Same arrangement cage/weston use.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
WorkingDirectory=/opt/hifi-qt
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_LOGGING_RULES=qt.qpa.input=false
# Persist Qt's compiled-QML (QV4 bytecode) cache across boots. The payload in
# /opt/hifi-qt ships plain .qml text on a read-only squashfs, and the service
# runs as root whose $HOME (/root) is read-only too, so with no writable cache
# dir Qt recompiled every .qml on every boot (measured ~1s on the Pi3 vc4, of
# which a persistent cache saves ~0.5s, and it also makes a Loader page's
# first-visit compile instant on later boots). /data is the writable data
# partition (mounted by the initramfs before systemd), so point HOME and the
# QML disk cache there. The cache keys on the Qt version and each .qml's mtime,
# so an OTA that changes the payload invalidates and rebuilds it once — no
# staleness. (This caches the QML bytecode only; vc4 GLES2 cannot reuse GL
# program binaries across runs, so Qt's separate qtpipelinecache stays
# ineffective and the first-use shader/pipeline cost is paid once per boot.)
Environment=HOME=/data/hifi-qt-home
Environment=XDG_CACHE_HOME=/data/hifi-qt-home/.cache
Environment=QML_DISK_CACHE_PATH=/data/hifi-qt-home/.cache/qmlc
# Bring terminal 1 to the front, or the screen keeps showing whichever was
# active before (usually the one lightdm left behind) while this interface
# draws on one nobody can see.
# 🚨 The leading dash is not a typo: chvt lives in the kbd package, which the
# appliance did NOT ship with. Without the dash, a missing chvt fails the unit
# with 203/EXEC BEFORE the program runs — black screen and an interface that
# "won't start", while starting it by hand from a terminal works. The package
# is installed now (image package list + migration 0056); this is the parachute
# for devices that do not have it yet.
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStartPre=-/usr/bin/chvt 1
# Make the writable cache dir before the interface starts; the leading dash
# keeps a failure (e.g. /data not yet mounted) from blocking the UI.
ExecStartPre=-/bin/mkdir -p /data/hifi-qt-home/.cache/qmlc
ExecStart=/opt/hifi-qt/hifi-qt --assets /opt/hifi-qt/assets --locales /opt/hifi-qt/locales
Restart=on-failure
RestartSec=3
Nice=-5

[Install]
WantedBy=graphical.target
